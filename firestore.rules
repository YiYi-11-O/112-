rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global counter and settings
    match /system/{docId} {
      allow read, write: if true;
    }

    // Subjects collection synced across devices
    match /subjects/{subjectId} {
      allow read, write: if true;
    }

    // Questions collection synced across devices
    match /questions/{questionId} {
      allow read, write: if true;
    }

    // Fallback deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
